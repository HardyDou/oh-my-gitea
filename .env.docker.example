# 复制为 .env.docker，不要提交真实凭据。
# 管理员密码首次在页面设置，无需 SYSTEM_CONFIG_TOKEN。
# Gitea 地址及 OAuth/Webhook 凭据在系统配置页面填写。
APP_URL=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# HTTP 本地试用设 false；HTTPS 正式部署必须设 true。
SESSION_COOKIE_SECURE=false

# 自行设置数据库密码，使用字母数字组合，避免连接 URL 的特殊字符问题。
POSTGRES_PASSWORD=

# 新部署留空即可，系统会自动生成加密密钥并保存到后端数据卷。
# 若旧部署已设置此值，升级时必须保留原值，不能改为空或替换。
SESSION_SECRET=
