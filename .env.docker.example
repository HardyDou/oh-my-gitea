# 复制为 .env.docker，不要提交真实密钥。
# Gitea 地址、Client ID、Client Secret、Webhook 密钥在系统配置页面填写。
# 浏览器访问地址，不带末尾斜杠。正式部署改为 https://pm.example.com。
APP_URL=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# HTTP 本地试用设 false；HTTPS 正式部署必须设 true。
SESSION_COOKIE_SECURE=false

# 分别运行 openssl rand -hex 32，生成以下三个不同密钥。
# 数据库密码使用十六进制，避免连接 URL 中的特殊字符编码问题。
POSTGRES_PASSWORD=
# 用于会话签名和 Gitea 配置加密；持久保存并随数据库一起备份。
SESSION_SECRET=
# 系统配置页面的管理密钥（至少 32 位），不要提供给普通用户。
SYSTEM_CONFIG_TOKEN=
