NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pm:pm@localhost:5432/gitea_pm
GITEA_REDIRECT_URI=http://localhost:3000/auth/gitea/callback
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# 新部署留空即可：系统自动生成到 .data/session-secret，请随数据库一起备份。
# 旧部署已设置此值时必须保留原值，避免已有配置无法解密。
SESSION_SECRET=

# 管理员密码首次在“系统配置 → Gitea 集成”页面自行设置，至少 8 位。
# 不再使用 SYSTEM_CONFIG_TOKEN。
# 兼容旧环境变量 GITEA_BASE_URL、GITEA_CLIENT_ID、GITEA_CLIENT_SECRET、
# GITEA_WEBHOOK_SECRET；数据库中存在配置时，以数据库为准。
