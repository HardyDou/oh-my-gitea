NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pm:pm@localhost:5432/gitea_pm
GITEA_REDIRECT_URI=http://localhost:3000/auth/gitea/callback
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# 分别使用 openssl rand -hex 32 生成；不能为空，也不要使用同一个值。
SESSION_SECRET=
SYSTEM_CONFIG_TOKEN=

# Gitea 地址及 OAuth/Webhook 凭据在“系统配置 → Gitea 集成”填写。
# 兼容旧环境变量 GITEA_BASE_URL、GITEA_CLIENT_ID、GITEA_CLIENT_SECRET、
# GITEA_WEBHOOK_SECRET；数据库中存在配置时，以数据库为准。
